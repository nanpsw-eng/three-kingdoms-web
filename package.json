{
  "name": "three-kingdoms-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:domain": "rm -rf .tmp/domain && tsc -p tsconfig.domain.json && node --test tests/domain-smoke.mjs",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run validate:content && npm run test && npm run build",
    "validate:content": "tsx scripts/validate-content.ts"
  },
  "dependencies": {
    "dexie": "4.4.6",
    "phaser": "4.2.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "fake-indexeddb": "6.2.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "5.0.3"
  }
}
